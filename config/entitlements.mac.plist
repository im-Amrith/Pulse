<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Pulse on macOS (needed for notarization). -->
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine needs these under the hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- control Spotify and Music (play, pause, skip) through Apple Events -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- the hook server and phone transfer listen on the network; lyrics and updates fetch from it -->
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
